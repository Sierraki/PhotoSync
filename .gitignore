# Release-only repository: ignore every file by default.
*

# Allow Git to traverse directories while files remain ignored.
!*/
!**/

# Repository metadata and documentation.
!/.gitignore
!/README.md
!/desktop/README.md
!/LICENSE
!/LICENSE.*
!/CHANGELOG.md

# Android release artifact.
!PhotoSync.apk

# Images used by the release documentation.
!image/**

# Windows release artifact.
!desktop/output/PhotoSync.exe
